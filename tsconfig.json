{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node"]
	},
	// TypeScript does not merge include/exclude with the extended config, so these
	// mirror SvelteKit's defaults
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}
